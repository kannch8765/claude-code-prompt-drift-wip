{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/prompt-drift/frozen-manifest.schema.json",
  "title": "Frozen customization manifest",
  "description": "Public contract for user-controlled frozen customization artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "createdAt",
    "synthetic",
    "upstreamSnapshot",
    "customizations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "upstreamSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "version",
        "inventoryDigest"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "customizations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "customizationId",
          "target",
          "artifacts",
          "matchHints"
        ],
        "properties": {
          "customizationId": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetId",
              "displayName",
              "expectedDigest"
            ],
            "properties": {
              "targetId": {
                "type": "string",
                "minLength": 1
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "expectedDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "basePath",
              "customizedPath",
              "customizedDigest"
            ],
            "properties": {
              "basePath": {
                "$ref": "#/$defs/relativePath"
              },
              "customizedPath": {
                "$ref": "#/$defs/relativePath"
              },
              "customizedDigest": {
                "$ref": "#/$defs/digest"
              }
            }
          },
          "matchHints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "aliases",
              "tags"
            ],
            "properties": {
              "aliases": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tags": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$",
      "description": "Portable relative path using forward slashes only; absolute paths, drive prefixes, backslashes, empty segments, and dot segments are forbidden."
    }
  }
}
